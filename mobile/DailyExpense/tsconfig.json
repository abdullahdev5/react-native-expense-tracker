{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,
    "paths": {
      "@components/*": ["./src/components/*"],
      "@assets/*": ["./assets/*"],
      "@/*": ["./src/*"]
    }
  },
  // "include": ["**/*.ts", "**/*.tsx"],
  "include": [
    "src",
    "**/*.ts",
    "**/*.tsx",
    // ".expo/types/**/*.ts",
    // "expo-env.d.ts"
  ],
  "exclude": ["**/node_modules", "**/Pods"]
}
